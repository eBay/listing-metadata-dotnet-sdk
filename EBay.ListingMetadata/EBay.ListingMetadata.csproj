<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EBay.ListingMetadata</RootNamespace>
    <AssemblyName>EBay.ListingMetadata</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>EBay.ListingMetadata</PackageId>
    <Version>0.3.0</Version>
    <Authors>eBay</Authors>
    <Description>Unified .NET SDK for eBay Listing Metadata APIs including Catalog, Taxonomy, Metadata, and Charity operations</Description>
    <PackageTags>ebay;api;sdk;listing;metadata;catalog;taxonomy;charity</PackageTags>
    <PackageProjectUrl>https://github.com/eBay/listing-metadata-dotnet-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/eBay/listing-metadata-dotnet-sdk</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- REST: Kiota runtime (includes Abstractions, Http, Serialization) -->
    <PackageReference Include="Microsoft.Kiota.Bundle" Version="1.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.*" />
    <PackageReference Include="System.Text.Json" Version="10.0.*" />

  </ItemGroup>

</Project>
